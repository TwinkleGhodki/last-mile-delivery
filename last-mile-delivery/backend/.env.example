# Server
PORT=4000

# Auth
JWT_SECRET=change-this-to-a-long-random-string

# Database (SQLite file path; created automatically)
DB_PATH=./data.sqlite

# Email (optional - if unset, emails are logged to console + saved to notifications table)
# Works with any SMTP provider's free tier, e.g. Gmail app password, Brevo, Mailtrap.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@delivery-tracker.local

# SMS (optional - if unset, SMS is logged to console + saved to notifications table)
# SMS_PROVIDER=twilio
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
